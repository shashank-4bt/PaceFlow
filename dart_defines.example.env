# Optional dart-define values for Firebase (do not commit real secrets).
# Copy to dart_defines.json and pass:
#   flutter run --dart-define-from-file=dart_defines.json
#
# Or use flutterfire configure to generate lib/firebase_options.dart instead.

FIREBASE_ANDROID_API_KEY=REPLACE_ME
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_PROJECT_ID=paceflow-dev
FIREBASE_STORAGE_BUCKET=paceflow-dev.appspot.com
